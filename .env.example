# Production / local secrets
ENVIRONMENT=production
SESSION_SECRET=replace-with-a-long-random-secret

# Optional explicit persistent paths. On Railway, attaching a Volume is enough.
# DATA_DIR=/data
# DATABASE_PATH=/data/store.db

# Brevo HTTPS transactional email API
# Create an API key in Brevo and verify BREVO_SENDER_EMAIL as a sender first.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=www.maneendrageneralstores@gmail.com
BREVO_SENDER_NAME=Maneendra General Stores
